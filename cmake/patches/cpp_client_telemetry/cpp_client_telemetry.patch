diff --git a/lib/CMakeLists.txt b/lib/CMakeLists.txt
index 0d41618..2b3c0fd 100644
--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -442,5 +442,13 @@ else()
 
    target_link_libraries(mat PRIVATE sqlite3_bundled zlib_bundled ${LIBS})
+  elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # On Apple mobile, use the SDK sqlite3 but let ORT supply a bundled zlib archive:
+    # the vendored zlib headers rename symbols to act_z_* so system zlib cannot satisfy them.
+    target_link_libraries(mat PRIVATE sqlite3 ${LIBS})
+  elseif(APPLE)
+    # On macOS, prefer portable system link names instead of absolute Homebrew archive paths
+    # so exported static packages remain relocatable for downstream consumers.
+    target_link_libraries(mat PRIVATE sqlite3 z ${LIBS})
  elseif(PAL_IMPLEMENTATION STREQUAL "WIN32")
    # Windows legacy: vendored sqlite/zlib headers are included via
    # include_directories in the PAL section above; link only ${LIBS}
